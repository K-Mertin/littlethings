{
  // Cloudflare Workers 部署設定：整個 repo 根目錄當成靜態網站
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "littleland",
  "compatibility_date": "2026-10-12",
  "observability": { "enabled": true },
  // 在 Cloudflare 後台手動設的一般變數（例如 CLAUDE_MODEL）部署時保留，不會被清掉
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // 只有 /api/* 會進到 worker；其他路徑照舊直接回靜態檔，不算 Worker 請求
    "run_worker_first": ["/api/*"]
  },
  // 後端：worker/index.js。Crystal Outpost 線上對戰，每個房間一個 Durable Object（免費方案只能用 SQLite 類別）
  "main": "worker/index.js",
  "durable_objects": {
    "bindings": [
      { "name": "OUTPOST_ROOMS", "class_name": "OutpostRoom" },
      { "name": "CHAT_GUARD", "class_name": "ChatGuard" },   // 大廳小幫手的次數限制
      { "name": "TTS_CACHE", "class_name": "TtsCache" },     // 小幫手朗讀的語音快取（一句一個）
      { "name": "LINK_ROOMS", "class_name": "LinkRoom" }     // 連線一起玩：每個房間一個，只負責轉送訊息
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OutpostRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["ChatGuard"] },
    { "tag": "v3", "new_sqlite_classes": ["TtsCache"] },
    { "tag": "v4", "new_sqlite_classes": ["LinkRoom"] }
  ]
}
